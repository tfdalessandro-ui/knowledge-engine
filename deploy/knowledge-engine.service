[Unit]
Description=CPU-First Knowledge Engine API (FastAPI/uvicorn)
After=network.target

[Service]
WorkingDirectory=/home/sensalis/work/knowledge_engine/src
Environment=PYTHONPATH=/home/sensalis/work/knowledge_engine/src
ExecStart=/home/sensalis/work/knowledge_engine/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
